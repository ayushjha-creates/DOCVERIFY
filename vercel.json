{
    "experimentalServices": {
        "frontend": {
            "entrypoint": "frontend",
            "routePrefix": "/",
            "framework": "nextjs"
        },
        "api": {
            "entrypoint": "api/index.py",
            "routePrefix": "/api",
            "framework": "fastapi"
        }
    },
    "functions": {
        "api/index.py": {
            "maxDuration": 60,
            "memory": 1024
        }
    }
}
